<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Pristup Odbijen</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>
    <ul>
        <li><a href="/" data-i18n="home">Početna</a></li>
        <li><a href="/galerija" data-i18n="gallery">Galerija</a></li>
        <li><a href="/statistika" data-i18n="statistics">Statistika</a></li>
        <% if (user) { %>
            <li><a href="/profile" data-i18n="profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout" data-i18n="logout">Odjava</a></li>
        <% } else { %>
            <li><a href="/auth/discord" data-i18n="login">Prijava</a></li>
        <% } %>
    </ul>
</nav>

<section class="hero">
    <div class="hero-content">

        <h1 data-i18n="accessDenied">🚫 Pristup odbijen</h1>

        <p data-i18n="noRoleAccess">
            Nemaš potrebnu rolu za pristup ovoj stranici.
        </p>

        <p style="opacity:0.7; margin-top:10px;" data-i18n="checkRoles">
            Ako smatraš da je ovo greška, provjeri svoje role na Discord serveru.
        </p>

        <div style="margin-top:30px;">
            <a href="https://discord.gg/XXXX" class="btn-primary" data-i18n="joinDiscord">
                Pridruži se Discordu
            </a>

            <a href="/" class="btn-secondary" style="margin-left:10px;" data-i18n="backToHome">
                Povratak na početnu
            </a>
        </div>

    </div>
</section>

<script src="/modal.js"></script>
<script src="/site.js"></script></body>
</html>
