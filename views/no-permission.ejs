<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Pristup Odbijen</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>
    <ul>
        <li><a href="/">Početna</a></li>
        <li><a href="/galerija">Galerija</a></li>
        <li><a href="/statistika">Statistika</a></li>
        <% if (user) { %>
            <li><a href="/profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout">Logout</a></li>
        <% } else { %>
            <li><a href="/auth/discord">Login</a></li>
        <% } %>
    </ul>
</nav>

<section class="hero">
    <div class="hero-content">

        <h1>🚫 Pristup odbijen</h1>

        <p>
            Nemaš potrebnu rolu za pristup ovoj stranici.
        </p>

        <p style="opacity:0.7; margin-top:10px;">
            Ako smatraš da je ovo greška, provjeri svoje role na Discord serveru.
        </p>

        <div style="margin-top:30px;">
            <a href="https://discord.gg/XXXX" class="btn-primary">
                Pridruži se Discordu
            </a>

            <a href="/" class="btn-secondary" style="margin-left:10px;">
                Povratak na početnu
            </a>
        </div>

    </div>
</section>

</body>
</html>
