<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Bot Postavke</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bot-settings-page">

<nav class="navbar">
  <div class="logo">
    <img src="/images/logo.png" alt="SR Logo">
    <span>Slavonska Ravnica</span>
  </div>
  <ul>
    <li><a href="/" data-i18n="home">Početna</a></li>
    <li><a href="/galerija" data-i18n="gallery">Galerija</a></li>
    <li><a href="/pravila" data-i18n="rules">Pravila</a></li>
    <li><a href="/statistika" data-i18n="statistics">Statistika</a></li>
    <li><a href="/moja-farma" data-i18n="myFarm">Moja Farma</a></li>
    <% if (user) { %>
      <li><a href="/profile" data-i18n="profile">Profil</a></li>
      <% if (canAdminNav) { %>
        <li><a href="/admin">Admin</a></li>
        <li><a href="/bot-settings">Bot</a></li>
      <% } %>
      <li><a href="/logout" data-i18n="logout">Odjava</a></li>
    <% } else { %>
      <li><a href="/auth/discord" data-i18n="login">Prijava</a></li>
    <% } %>
  </ul>
</nav>

<section class="admin-shell">
  <div class="admin-topbar">
    <div>
      <p class="admin-kicker">Discord upravljanje</p>
      <h1>Bot Postavke</h1>
      <p class="admin-subtitle">Centralne postavke Discord bota odvojene od glavnog admin panela.</p>
    </div>
  </div>

  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <span class="admin-stat-label">Sinkronizirane role</span>
      <strong><%= discordSync ? discordSync.rolesCount : 0 %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Sinkr. članovi</span>
      <strong><%= discordSync ? discordSync.membersCount : 0 %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Veze rola</span>
      <strong><%= discordSync ? discordSync.memberRolesCount : 0 %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Embeds</span>
      <strong><%= botConfig && botConfig.embeds ? botConfig.embeds.length : 0 %></strong>
    </div>
  </div>

  <% const bot = botConfig || {}; const ticket = bot.ticketSystem || {}; %>
  <div class="admin-wrapper">
    <div class="admin-section">
      <div class="admin-header">
        <div>
          <span class="admin-header-label">Discord Bot</span>
          <small>Sinkronizacija, dobrodo?lica, zapisnici i galerija</small>
        </div>
        <span class="admin-header-count"><%= syncedRoles ? syncedRoles.length : 0 %></span>
      </div>

      <div class="admin-content open">
        <div class="bot-settings-top-grid">
          <form method="POST" action="/admin/discord-sync" class="admin-form compact-form bot-settings-card">
            <div class="bot-settings-card-head">
              <label class="admin-field-label">Discord sinkronizacija</label>
              <span class="admin-pill">Sinkr.</span>
            </div>
            <p class="admin-empty">Role: <%= discordSync ? discordSync.rolesCount : 0 %> | Članovi: <%= discordSync ? discordSync.membersCount : 0 %> | Veze: <%= discordSync ? discordSync.memberRolesCount : 0 %></p>
            <button type="submit" class="admin-action-btn">Pokreni sync</button>
          </form>

          <form method="POST" action="/admin/bot/greetings" class="admin-form compact-form bot-settings-card">
            <div class="bot-settings-card-head">
              <label class="admin-field-label">Postavke dobrodo?lice</label>
              <span class="admin-pill">Pozdrav</span>
            </div>
            <select name="welcomeChannelId" class="admin-select">
              <option value="">Odaberi kanal dobrodo?lice</option>
              <% (guildChannels || []).forEach(channel => { %>
                <option value="<%= channel.id %>" <%= bot.welcome && bot.welcome.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %> · <%= channel.id %></option>
              <% }) %>
            </select>
            <textarea name="welcomeMessage" placeholder="Dobrodošlica..."><%= bot.welcome ? bot.welcome.message : '' %></textarea>
            <button type="submit" class="admin-secondary-btn">Spremi dobrodo?licu</button>
          </form>

          <form method="POST" action="/admin/bot/logging" class="admin-form compact-form bot-settings-card">
            <div class="bot-settings-card-head">
              <label class="admin-field-label">Log kanal</label>
              <span class="admin-pill">Logovi</span>
            </div>
            <select name="logChannelId" class="admin-select">
              <option value="">Odaberi log kanal</option>
              <% (guildChannels || []).forEach(channel => { %>
                <option value="<%= channel.id %>" <%= bot.logging && bot.logging.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %> · <%= channel.id %></option>
              <% }) %>
            </select>
            <button type="submit" class="admin-secondary-btn">Spremi logging</button>
          </form>
        </div>

        <div class="bot-settings-stack">
          <section class="bot-settings-panel">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Galerija kanal</h3>
              <span class="admin-pill">Mediji</span>
            </div>

            <form method="POST" action="/admin/bot/gallery" class="admin-form compact-form">
              <select name="galleryChannelId" class="admin-select">
                <option value="">Odaberi galerija kanal</option>
                <% (guildChannels || []).forEach(channel => { %>
                  <option value="<%= channel.id %>" <%= bot.gallery && bot.gallery.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %> · <%= channel.id %></option>
                <% }) %>
              </select>
              <button type="submit" class="admin-secondary-btn">Spremi galeriju</button>
            </form>
          </section>

          <section class="bot-settings-panel">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Tiket sustav</h3>
              <span class="admin-pill"><%= syncedRoles ? syncedRoles.length : 0 %> rola</span>
            </div>

            <form method="POST" action="/admin/bot/tickets" class="admin-form admin-rule-form">
              <label class="admin-field-label">Ticket kategorija</label>
              <select name="ticketCategoryId" class="admin-select">
                <option value="">Odaberi ticket kategoriju</option>
                <% (guildChannels || []).forEach(channel => { %>
                  <option value="<%= channel.id %>" <%= ticket.categoryId === channel.id ? 'selected' : '' %>>#<%= channel.name %> · <%= channel.id %></option>
                <% }) %>
              </select>
              <label class="admin-field-label">Ticket log kanal</label>
              <select name="ticketLogChannelId" class="admin-select">
                <option value="">Odaberi ticket log kanal</option>
                <% (guildChannels || []).forEach(channel => { %>
                  <option value="<%= channel.id %>" <%= ticket.logChannelId === channel.id ? 'selected' : '' %>>#<%= channel.name %> · <%= channel.id %></option>
                <% }) %>
              </select>
              <label class="admin-field-label">Support rola</label>
              <select name="ticketSupportRoleId" class="admin-select">
                <option value="">Odaberi support rolu</option>
                <% (syncedRoles || []).forEach(role => { %>
                  <option value="<%= role.id %>" <%= ticket.supportRoleId === role.id ? 'selected' : '' %>><%= role.name %> · <%= role.id %></option>
                <% }) %>
              </select>
              <label class="admin-field-label">Launcher kanal</label>
              <select name="ticketLauncherChannelId" class="admin-select">
                <option value="">Odaberi launcher kanal</option>
                <% (guildChannels || []).forEach(channel => { %>
                  <option value="<%= channel.id %>" <%= ticket.launcherChannelId === channel.id ? 'selected' : '' %>>#<%= channel.name %> · <%= channel.id %></option>
                <% }) %>
              </select>
              <label class="admin-field-label">Sati do automatskog zatvaranja</label>
              <input type="number" name="autoCloseHours" min="1" value="<%= ticket.autoCloseHours || 48 %>" placeholder="Sati do automatskog zatvaranja">
              <label class="admin-field-label">Sati do podsjetnika</label>
              <input type="number" name="reminderHours" min="1" value="<%= ticket.reminderHours || 3 %>" placeholder="Sati do podsjetnika">
              <label class="admin-field-label">Pitanja: Igranje na serveru</label>
              <textarea name="igranjeQuestions" rows="6" placeholder="Jedno pitanje po redu"><%= ticket.types && ticket.types.igranje ? ticket.types.igranje.questions.join('\n') : '' %></textarea>
              <label class="admin-field-label">Pitanja: Žalba na igrače</label>
              <textarea name="zalbaQuestions" rows="4" placeholder="Žalba pitanja"><%= ticket.types && ticket.types.zalba ? ticket.types.zalba.questions.join('\n') : '' %></textarea>
              <label class="admin-field-label">Pitanja: Edit modova</label>
              <textarea name="modoviQuestions" rows="4" placeholder="Jedno pitanje po redu"><%= ticket.types && ticket.types.modovi ? ticket.types.modovi.questions.join('\n') : '' %></textarea>
              <label class="admin-field-label">Pitanja: Pomoć</label>
              <textarea name="pomocQuestions" rows="4" placeholder="Pomoć pitanja"><%= ticket.types && ticket.types.pomoc ? ticket.types.pomoc.questions.join('\n') : '' %></textarea>
              <label class="admin-field-label">Reminder poruka</label>
              <textarea name="reminderMessage" rows="4" placeholder="Poruka za podsjetnik"><%= ticket.messages ? ticket.messages.reminder : '' %></textarea>
              <label class="admin-field-label">Auto close poruka</label>
              <textarea name="autoCloseMessage" rows="4" placeholder="Poruka za automatsko zatvaranje"><%= ticket.messages ? ticket.messages.autoClose : '' %></textarea>
              <label class="admin-field-label">Igranje welcome naslov</label>
              <input type="text" name="igranjeWelcomeTitle" value="<%= ticket.messages ? ticket.messages.igranjeWelcomeTitle || '' : '' %>" placeholder="Naslov prve poruke">
              <label class="admin-field-label">Igranje welcome poruka</label>
              <textarea name="igranjeWelcomeBody" rows="8" placeholder="Možeš koristiti {launcherChannel} i {guildName}"><%= ticket.messages ? ticket.messages.igranjeWelcomeBody || '' : '' %></textarea>
              <label class="admin-field-label">Pravila naslov</label>
              <input type="text" name="igranjeRulesTitle" value="<%= ticket.messages ? ticket.messages.igranjeRulesTitle || '' : '' %>" placeholder="Naslov pravila">
              <label class="admin-field-label">Pravila poruka</label>
              <textarea name="igranjeRulesBody" rows="7" placeholder="Tekst pravila servera"><%= ticket.messages ? ticket.messages.igranjeRulesBody || '' : '' %></textarea>
              <label class="admin-field-label">Launcher naslov</label>
              <input type="text" name="igranjeLauncherTitle" value="<%= ticket.messages ? ticket.messages.igranjeLauncherTitle || '' : '' %>" placeholder="Naslov launcher poruke">
              <label class="admin-field-label">Launcher poruka</label>
              <textarea name="igranjeLauncherBody" rows="8" placeholder="Možeš koristiti {launcherChannel} i {guildName}"><%= ticket.messages ? ticket.messages.igranjeLauncherBody || '' : '' %></textarea>
              <div class="admin-inline-actions">
                <button type="submit" class="admin-action-btn">Spremi ticket postavke</button>
              </div>
            </form>
          </section>

          <section class="bot-settings-panel">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Pošalji embed</h3>
              <span class="admin-pill"><%= bot.embeds ? bot.embeds.length : 0 %></span>
            </div>

            <div class="bot-embed-layout">
              <form method="POST" action="/admin/bot/embeds" class="admin-form admin-rule-form" id="embed-builder-form">
                <select name="embedChannelId" class="admin-select" required>
                  <option value="">Odaberi kanal za embed</option>
                  <% (guildChannels || []).forEach(channel => { %>
                    <option value="<%= channel.id %>">#<%= channel.name %> · <%= channel.id %></option>
                  <% }) %>
                </select>
                <input type="text" name="title" placeholder="Naslov embed-a">
                <textarea name="description" rows="4" placeholder="Opis embed-a"></textarea>
                <input type="text" name="color" placeholder="#2f855a">
                <input type="text" name="authorName" placeholder="Autor">
                <input type="text" name="authorIcon" placeholder="URL ikone autora">
                <input type="text" name="footerText" placeholder="Tekst podno?ja">
                <input type="text" name="footerIcon" placeholder="URL ikone podno?ja">
                <input type="text" name="thumbnailUrl" placeholder="URL sli?ice">
                <input type="text" name="imageUrl" placeholder="URL slike">
                <input type="text" name="launcherButtonLabel" placeholder="Tekst dugmeta">
                <input type="text" name="launcherButtonUrl" placeholder="Link dugmeta">
                <textarea name="normalMessage" rows="2" placeholder="Običan tekst uz embed"></textarea>
                <label class="admin-field-label"><input type="checkbox" name="timestamp" checked> Dodaj timestamp</label>
                <div class="admin-inline-actions">
                  <button type="submit" class="admin-action-btn">Pošalji embed</button>
                </div>
              </form>

              <div class="embed-preview-shell">
                <div class="admin-content-title-row">
                  <h3 class="admin-content-title">Pregled embeda</h3>
                  <span class="admin-pill">U?ivo</span>
                </div>
                <div class="discord-preview">
                  <div class="discord-preview-message" id="embed-preview-message" hidden></div>
                  <article class="discord-embed-preview">
                    <div class="discord-embed-bar" id="embed-preview-bar"></div>
                    <div class="discord-embed-body">
                      <div class="discord-embed-author" id="embed-preview-author-row" hidden>
                        <img id="embed-preview-author-icon" alt="Autor">
                        <span id="embed-preview-author-text"></span>
                      </div>
                      <div class="discord-embed-grid">
                        <div class="discord-embed-main">
                          <h4 id="embed-preview-title">Naslov embed-a</h4>
                          <p id="embed-preview-description">Opis embed-a će se prikazati ovdje čim upišeš tekst.</p>
                          <div class="discord-embed-footer" id="embed-preview-footer-row">
                            <img id="embed-preview-footer-icon" alt="Footer">
                            <span id="embed-preview-footer-text">Tekst podno?ja</span>
                          </div>
                        </div>
                        <div class="discord-embed-thumb-wrap" id="embed-preview-thumb-wrap" hidden>
                          <img id="embed-preview-thumbnail" alt="Sli?ica">
                        </div>
                      </div>
                      <div class="discord-embed-image-wrap" id="embed-preview-image-wrap" hidden>
                        <img id="embed-preview-image" alt="Slika embeda">
                      </div>
                      <div class="discord-embed-button-row" id="embed-preview-button-row" hidden>
                        <span class="discord-embed-button" id="embed-preview-button-label"></span>
                      </div>
                    </div>
                  </article>
                </div>
              </div>
            </div>
          </section>

          <section class="bot-settings-panel">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Sinkronizirane role</h3>
              <span class="admin-pill"><%= syncedRoles ? syncedRoles.length : 0 %></span>
            </div>

            <% if (syncedRoles && syncedRoles.length > 0) { %>
              <div class="all-roles">
                <% syncedRoles.forEach(role => { %>
                  <span class="role-pill" style="background:<%= role.color || '#444' %>"><%= role.name %></span>
                <% }) %>
              </div>
            <% } else { %>
              <p class="admin-empty">Role još nisu sinkronizirane.</p>
            <% } %>
          </section>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/modal.js"></script>
<script src="/site.js"></script>
<script>
(function () {
  const form = document.getElementById('embed-builder-form');
  if (!form) return;

  const getField = function (name) {
    return form.querySelector('[name="' + name + '"]');
  };

  const preview = {
    message: document.getElementById('embed-preview-message'),
    bar: document.getElementById('embed-preview-bar'),
    title: document.getElementById('embed-preview-title'),
    description: document.getElementById('embed-preview-description'),
    authorRow: document.getElementById('embed-preview-author-row'),
    authorIcon: document.getElementById('embed-preview-author-icon'),
    authorText: document.getElementById('embed-preview-author-text'),
    footerIcon: document.getElementById('embed-preview-footer-icon'),
    footerText: document.getElementById('embed-preview-footer-text'),
    thumbWrap: document.getElementById('embed-preview-thumb-wrap'),
    thumbnail: document.getElementById('embed-preview-thumbnail'),
    imageWrap: document.getElementById('embed-preview-image-wrap'),
    image: document.getElementById('embed-preview-image'),
    buttonRow: document.getElementById('embed-preview-button-row'),
    buttonLabel: document.getElementById('embed-preview-button-label')
  };

  function setPreviewImage(imageEl, wrapEl, url) {
    const value = String(url || '').trim();
    if (!value) {
      if (wrapEl) wrapEl.hidden = true;
      imageEl.removeAttribute('src');
      return;
    }

    imageEl.src = value;
    if (wrapEl) wrapEl.hidden = false;
    imageEl.onerror = function () {
      if (wrapEl) wrapEl.hidden = true;
    };
  }

  function updateEmbedPreview() {
    const title = String(getField('title').value || '').trim();
    const description = String(getField('description').value || '').trim();
    const color = String(getField('color').value || '').trim() || '#2f855a';
    const authorName = String(getField('authorName').value || '').trim();
    const authorIcon = String(getField('authorIcon').value || '').trim();
    const footerText = String(getField('footerText').value || '').trim();
    const footerIcon = String(getField('footerIcon').value || '').trim();
    const thumbnailUrl = String(getField('thumbnailUrl').value || '').trim();
    const imageUrl = String(getField('imageUrl').value || '').trim();
    const buttonLabel = String(getField('launcherButtonLabel').value || '').trim();
    const normalMessage = String(getField('normalMessage').value || '').trim();
    const useTimestamp = Boolean(getField('timestamp').checked);
    const timeText = new Date().toLocaleTimeString('hr-HR', { hour: '2-digit', minute: '2-digit' });

    preview.message.hidden = !normalMessage;
    preview.message.textContent = normalMessage;
    preview.bar.style.background = color;
    preview.title.textContent = title || 'Naslov embed-a';
    preview.description.textContent = description || 'Opis embed-a će se prikazati ovdje čim upišeš tekst.';

    preview.authorRow.hidden = !authorName;
    preview.authorText.textContent = authorName;
    preview.authorIcon.style.display = authorIcon ? 'block' : 'none';
    setPreviewImage(preview.authorIcon, null, authorIcon);

    preview.footerText.textContent = footerText || 'Tekst podno?ja';
    if (useTimestamp) {
      preview.footerText.textContent += ' • Danas u ' + timeText;
    }
    preview.footerIcon.style.display = footerIcon ? 'block' : 'none';
    setPreviewImage(preview.footerIcon, null, footerIcon);

    setPreviewImage(preview.thumbnail, preview.thumbWrap, thumbnailUrl);
    setPreviewImage(preview.image, preview.imageWrap, imageUrl);

    preview.buttonRow.hidden = !buttonLabel;
    preview.buttonLabel.textContent = buttonLabel;
  }

  form.addEventListener('input', updateEmbedPreview);
  form.addEventListener('change', updateEmbedPreview);
  updateEmbedPreview();
})();
</script>
</body>
</html>
