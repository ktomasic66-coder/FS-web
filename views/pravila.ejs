<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Pravila | Slavonska Ravnica</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="rules-page">

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>

    <ul>
        <li><a href="/" data-i18n="home">Početna</a></li>
        <li><a href="/galerija" data-i18n="gallery">Galerija</a></li>
        <li><a href="/pravila" data-i18n="rules">Pravila</a></li>
        <li><a href="/statistika" data-i18n="statistics">Statistika</a></li>
        <li><a href="/moja-farma" data-i18n="myFarm">Moja Farma</a></li>

        <% if (user) { %>
            <li><a href="/profile" data-i18n="profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout" data-i18n="logout">Odjava</a></li>
        <% } else { %>
            <li><a href="/auth/discord" data-i18n="login">Prijava</a></li>
        <% } %>
    </ul>
</nav>

<section class="rules-hero">
    <div class="rules-hero-inner">
        <p class="rules-kicker" data-i18n="serverPolicy">Pravila servera</p>
        <h1><%= rules.title %></h1>
        <p class="rules-sub"><%= rules.subtitle %></p>
    </div>
    <div class="rules-orb rules-orb-one"></div>
    <div class="rules-orb rules-orb-two"></div>
</section>

<section class="rules-showcase">
    <% if (rules.items && rules.items.length > 0) { %>
        <div class="rules-grid-modern">
            <% rules.items.forEach((rule, index) => { %>
                <article class="rules-card-modern">
                    <div class="rules-card-top">
                        <h3><%= rule.title %></h3>
                        <span class="rules-card-line"></span>
                    </div>
                    <p><%= rule.content %></p>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <div class="rules-empty-state">
            <strong data-i18n="rulesNotAdded">Pravila jo? nisu dodana.</strong>
            <p data-i18n="rulesNotAddedDesc">Admin ih mo?e dodati i urediti unutar admin panela.</p>
        </div>
    <% } %>

    <div class="rules-warning-banner">
        <strong data-i18n="note">Napomena</strong>
        <p><%= rules.warning %></p>
    </div>
</section>

<footer class="site-footer">
    <div class="site-footer-inner">
        <div>
            <strong>Slavonska Ravnica</strong>
            <p data-i18n="footerDesc">Pravila i informacije za sve ?lanove zajednice.</p>
        </div>
        <div class="site-footer-links">
            <a href="/" data-i18n="home">Početna</a>
            <a href="/pravila" data-i18n="rules">Pravila</a>
            <a href="/galerija" data-i18n="gallery">Galerija</a>
            <a href="/statistika" data-i18n="statistics">Statistika</a>
        </div>
    </div>
</footer>

<script src="/modal.js"></script>
<script src="/site.js"></script></body>
</html>
