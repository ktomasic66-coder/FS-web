<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Pravila | Slavonska Ravnica</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="rules-page">

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>

    <ul>
        <li><a href="/">Početna</a></li>
        <li><a href="/galerija">Galerija</a></li>
        <li><a href="/pravila">Pravila</a></li>
        <li><a href="/statistika">Statistika</a></li>
        <li><a href="/moja-farma">Moja Farma</a></li>

        <% if (user) { %>
            <li><a href="/profile">Profil</a></li>
            <li><a href="/admin">Admin</a></li>
            <li><a href="/logout">Logout</a></li>
        <% } else { %>
            <li><a href="/auth/discord">Login</a></li>
        <% } %>
    </ul>
</nav>

<section class="rules-hero">
    <div class="rules-hero-inner">
        <p class="rules-kicker">Server policy</p>
        <h1><%= rules.title %></h1>
        <p class="rules-sub"><%= rules.subtitle %></p>
    </div>
    <div class="rules-orb rules-orb-one"></div>
    <div class="rules-orb rules-orb-two"></div>
</section>

<section class="rules-showcase">
    <% if (rules.items && rules.items.length > 0) { %>
        <div class="rules-grid-modern">
            <% rules.items.forEach((rule, index) => { %>
                <article class="rules-card-modern">
                    <div class="rules-card-top">
                        <h3><%= rule.title %></h3>
                        <span class="rules-card-line"></span>
                    </div>
                    <p><%= rule.content %></p>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <div class="rules-empty-state">
            <strong>Pravila jos nisu dodana.</strong>
            <p>Admin ih moze dodati i urediti unutar admin panela.</p>
        </div>
    <% } %>

    <div class="rules-warning-banner">
        <strong>Napomena</strong>
        <p><%= rules.warning %></p>
    </div>
</section>

<footer class="site-footer">
    <div class="site-footer-inner">
        <div>
            <strong>Slavonska Ravnica</strong>
            <p>Pravila i informacije za sve clanove zajednice.</p>
        </div>
        <div class="site-footer-links">
            <a href="/">Početna</a>
            <a href="/pravila">Pravila</a>
            <a href="/galerija">Galerija</a>
            <a href="/statistika">Statistika</a>
        </div>
    </div>
</footer>

</body>
</html>
