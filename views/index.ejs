<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Slavonska Ravnica | FS25 Server</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
    <style>
      .news-modal-overlay {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.7);
        z-index: 99999;
      }

      .news-modal-overlay.open { display: flex; }

      .news-modal {
        position: relative;
        width: min(760px, 100%);
        max-height: 88vh;
        overflow-y: auto;
        background: rgba(5, 18, 14, 0.96);
        border: 1px solid var(--accent);
        border-radius: 18px;
        box-shadow: 0 0 35px rgba(var(--accent-rgb), 0.15);
        padding: 24px 22px;
        color: #e9fff6;
        transform: translateY(34px) scale(0.98);
        opacity: 0;
        transition: transform 220ms ease, opacity 220ms ease;
      }

      .news-modal-overlay.show .news-modal {
        transform: translateY(0) scale(1);
        opacity: 1;
      }

      .news-modal-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border: 1px solid rgba(var(--accent-rgb), 0.35);
        border-radius: 10px;
        background: transparent;
        color: #d8fff0;
        cursor: pointer;
        font-size: 20px;
        line-height: 1;
      }

      .news-modal-content {
        white-space: pre-line;
        line-height: 1.7;
      }
    </style>
</head>

<body>

<div id="particles-js"></div>

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>

    <ul>
        <li><a href="/" data-i18n="home">Početna</a></li>
        <li><a href="/galerija" data-i18n="gallery">Galerija</a></li>
        <li><a href="/pravila" data-i18n="rules">Pravila</a></li>
        <li><a href="/statistika" data-i18n="statistics">Statistika</a></li>
        <li><a href="/moja-farma" data-i18n="myFarm">Moja Farma</a></li>

        <% if(user){ %>
            <li><a href="/profile" data-i18n="profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout" data-i18n="logout">Logout</a></li>
        <% } else { %>
            <li><a href="/auth/discord" data-i18n="login">Login</a></li>
        <% } %>
    </ul>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <h1 data-i18n="heroTitle">Slavonska Ravnica  FS25 Server</h1>
        <p data-i18n="heroDesc">
            Realističan Farming Simulator 25 multiplayer s fokusom na ekonomiju,
            timski rad i dugoročni razvoj farmi.
        </p>

        <% if(!user){ %>
            <a href="/auth/discord" class="btn-primary" data-i18n="loginDiscord">
                Prijava putem Discorda
            </a>
        <% } else { %>
            <div class="profile">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png">
                <h2><%= user.username %></h2>
            </div>
        <% } %>
    </div>
</section>

<div class="news-section">
  <section class="news-section">
  <h2 class="news-title" data-i18n="news">📰 Novosti</h2>

  <% if(!news || news.length === 0) { %>
    <p class="no-news" data-i18n="noPosts">Nema objava.</p>
  <% } else { %>
    <div class="news-grid">
      <% news.slice(0,4).forEach((post, idx) => { %>
        <div class="news-card" role="button" tabindex="0" data-news-index="<%= idx %>">
          <h3><%= post.title %></h3>

          <p class="news-content">
            <%= post.content.length > 120 ? post.content.substring(0,120) + "..." : post.content %>
          </p>

          <div class="news-meta">
            <span><%= post.author %></span>
            <span><%= post.date %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
</div>

<div id="newsModalOverlay" class="news-modal-overlay">
  <div class="news-modal" role="dialog" aria-modal="true" aria-labelledby="newsModalTitle">
    <button id="newsModalClose" class="news-modal-close" type="button" aria-label="Zatvori">&times;</button>
    <h3 id="newsModalTitle"></h3>
    <p id="newsModalContent" class="news-modal-content"></p>
    <div class="news-modal-meta">
      <span id="newsModalAuthor"></span>
      <span id="newsModalDate"></span>
    </div>
  </div>
</div>

<!-- TKO SMO MI -->

<% if (typeof farmsOverview !== 'undefined' && farmsOverview && farmsOverview.length > 0) { %>
<!-- AKTIVNE FARME -->
<section class="section farms-overview-section">
    <h2 class="farms-overview-title" data-i18n="activeFarms">🌾 Aktivne Farme</h2>
    <div class="farms-overview-grid">
        <% 
        const farmColorMap = {
            '0': { bg: 'rgba(100,116,139,0.15)', border: 'rgba(100,116,139,0.4)', accent: '#94a3b8', dot: '#64748b' },
            '1': { bg: 'rgba(59,130,246,0.15)', border: 'rgba(59,130,246,0.4)', accent: '#60a5fa', dot: '#3b82f6' },
            '2': { bg: 'rgba(245,158,11,0.15)', border: 'rgba(245,158,11,0.4)', accent: '#fbbf24', dot: '#f59e0b' },
            '3': { bg: 'rgba(244,63,94,0.15)', border: 'rgba(244,63,94,0.4)', accent: '#fb7185', dot: '#f43f5e' },
            '4': { bg: 'rgba(168,85,247,0.15)', border: 'rgba(168,85,247,0.4)', accent: '#c084fc', dot: '#a855f7' },
            '5': { bg: 'rgba(6,182,212,0.15)', border: 'rgba(6,182,212,0.4)', accent: '#22d3ee', dot: '#06b6d4' },
            '6': { bg: 'rgba(16,185,129,0.15)', border: 'rgba(16,185,129,0.4)', accent: '#34d399', dot: '#10b981' },
            '7': { bg: 'rgba(249,115,22,0.15)', border: 'rgba(249,115,22,0.4)', accent: '#fb923c', dot: '#f97316' },
            '8': { bg: 'rgba(236,72,153,0.15)', border: 'rgba(236,72,153,0.4)', accent: '#f472b6', dot: '#ec4899' },
        };
        const defaultColor = { bg: 'rgba(255,255,255,0.05)', border: 'rgba(255,255,255,0.1)', accent: '#888', dot: '#666' };
        %>
        <% farmsOverview.forEach(function(farm) { %>
            <% const fc = farmColorMap[farm.farmId] || defaultColor; %>
            <div class="farms-overview-card" style="background: <%= fc.bg %>; border-color: <%= fc.border %>;">
                <div class="farms-overview-card-header">
                    <div class="farms-overview-card-dot" style="background: <%= fc.dot %>;"></div>
                    <h3 style="color: <%= fc.accent %>;"><%= farm.name %></h3>
                    <span class="farms-overview-farmid" style="color: <%= fc.accent %>; border-color: <%= fc.border %>;">F<%= farm.farmId %></span>
                </div>
                <div class="farms-overview-stats">
                    <div class="farms-overview-stat">
                        <span class="farms-overview-stat-val" style="color: <%= fc.accent %>;"><%= Math.round(farm.balance).toLocaleString('hr-HR') %> €</span>
                        <span class="farms-overview-stat-label" data-i18n="balance">Stanje</span>
                    </div>
                    <div class="farms-overview-stat">
                        <span class="farms-overview-stat-val" style="color: <%= fc.accent %>;">​<%= farm.fieldCount %></span>
                        <span class="farms-overview-stat-label" data-i18n="fields">Polja</span>
                    </div>
                    <div class="farms-overview-stat">
                        <span class="farms-overview-stat-val" style="color: <%= fc.accent %>;">​<%= farm.totalArea.toFixed(1) %> ha</span>
                        <span class="farms-overview-stat-label" data-i18n="surfaceArea">Površina</span>
                    </div>
                </div>
                <% if(farm.players && farm.players.length > 0) { %>
                <div class="farms-overview-players">
                    <% farm.players.forEach(function(p) { %>
                        <div class="farms-overview-player">
                            <span class="farms-overview-player-dot <%= p.isOnline ? 'dot-online' : 'dot-offline' %>"></span>
                            <span class="farms-overview-player-name"><%= p.name %></span>
                        </div>
                    <% }) %>
                </div>
                <% } else { %>
                <div class="farms-overview-no-players" data-i18n="noPlayersOnFarm">Nema igrača na farmi</div>
                <% } %>
            </div>
        <% }) %>
    </div>
</section>
<% } %>

<section class="section">
    <h2 data-i18n="whoAreWe">Tko smo mi</h2>
    <p data-i18n="whoAreWeDesc">
        Slavonska Ravnica je zajednica igrača koji žele kvalitetno i organizirano FS25 iskustvo.
        Gradimo server gdje trud ima vrijednost, a napredak dolazi kroz rad i suradnju.
        Kod nas farme imaju priču.
    </p>
</section>

<!-- STO NUDIMO -->
<section class="section cards">
    <div class="card">
        <h3 data-i18n="realisticEcon">🚜 Realistična ekonomija</h3>
        <p data-i18n="realisticEconDesc">Balansiran sustav napretka bez preskakanja faza.</p>
    </div>

    <div class="card">
        <h3 data-i18n="activeCommunity">👥 Aktivna zajednica</h3>
        <p data-i18n="activeCommunityDesc">Ozbiljna i organizirana ekipa.</p>
    </div>

    <div class="card">
        <h3 data-i18n="events">🏆 Eventovi</h3>
        <p data-i18n="eventsDesc">Redovni izazovi i zajednički projekti.</p>
    </div>

    <div class="card">
        <h3 data-i18n="stableServer">🛠 Stabilan server</h3>
        <p data-i18n="stableServerDesc">Optimizirano i dugoročno iskustvo.</p>
    </div>
</section>

<!-- KAKO SE PRIDRUZITI -->
<section class="section join-section">
    <h2 data-i18n="howToJoin">Kako se pridružiti</h2>

    <div class="join-steps">
        <div class="step">
            <span>1</span>
            <p data-i18n="step1">Prijavi se putem Discorda</p>
        </div>

        <div class="step">
            <span>2</span>
            <p data-i18n="step2">Pridruži se Discordu</p>
        </div>

        <div class="step">
            <span>3</span>
            <p data-i18n="step3">Otvori tiket za role PLAYER</p>
        </div>

        <div class="step">
            <span>4</span>
            <p data-i18n="step4">Kreni graditi svoju farmu</p>
        </div>
    </div>
</section>


<!-- CTA -->
<section class="cta-banner">
    <h2 data-i18n="readyForMultiplayer">Spreman za ozbiljan multiplayer?</h2>

    <% if(!user){ %>
        <a href="/auth/discord" class="btn-primary" data-i18n="loginToJoin">
            Prijavi se da bi se pridružio
        </a>
    <% } else { %>
        <a href="https://discord.gg/slavonskaravnica" class="btn-primary" target="_blank" data-i18n="joinCommunity">
            Pridruži se zajednici
        </a>
    <% } %>
</section>


<script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
<script>
particlesJS("particles-js", {
  particles: {
    number: { value: 70 },
    size: { value: 3 },
    move: { speed: 1 },
    line_linked: { enable: true, opacity: 0.2 },
  }
});

const NEWS_DATA = <%- JSON.stringify((news || []).slice(0,4)) %>;
const newsModalOverlay = document.getElementById("newsModalOverlay");
const newsModalTitle = document.getElementById("newsModalTitle");
const newsModalContent = document.getElementById("newsModalContent");
const newsModalAuthor = document.getElementById("newsModalAuthor");
const newsModalDate = document.getElementById("newsModalDate");
const newsModalClose = document.getElementById("newsModalClose");
const newsModal = newsModalOverlay.querySelector(".news-modal");

function openNewsModal(index) {
  const post = NEWS_DATA[index];
  if (!post) return;

  newsModalTitle.textContent = post.title || "";
  newsModalContent.textContent = post.content || "";
  newsModalAuthor.textContent = post.author || "";
  newsModalDate.textContent = post.date || "";
  newsModalOverlay.classList.add("open");
  requestAnimationFrame(() => newsModalOverlay.classList.add("show"));
}

function closeNewsModal() {
  newsModalOverlay.classList.remove("show");
  setTimeout(() => newsModalOverlay.classList.remove("open"), 220);
}

document.querySelectorAll(".news-card").forEach((card) => {
  card.addEventListener("click", () => openNewsModal(Number(card.dataset.newsIndex)));
  card.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      openNewsModal(Number(card.dataset.newsIndex));
    }
  });
});

newsModalClose.addEventListener("click", closeNewsModal);
newsModal.addEventListener("click", (e) => e.stopPropagation());
newsModalOverlay.addEventListener("click", (e) => {
  if (e.target === newsModalOverlay) closeNewsModal();
});
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") closeNewsModal();
});
</script>

<script src="/modal.js"></script>
<script src="/site.js"></script></body>
</html>
