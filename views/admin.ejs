<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Admin Panel</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/style.css">

  <script>
    function togglePanel(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.toggle("open");
    }
  </script>
</head>
<body>

<nav class="navbar">
  <div class="logo">
    <img src="/images/logo.png" alt="SR Logo">
    <span>Slavonska Ravnica</span>
  </div>
  <ul>
    <li><a href="/">Početna</a></li>
    <li><a href="/galerija">Galerija</a></li>
    <li><a href="/pravila">Pravila</a></li>
    <li><a href="/statistika">Statistika</a></li>
    <li><a href="/moja-farma">Moja Farma</a></li>
    <li><a href="/profile">Profil</a></li>
    <li><a href="/bot-settings">Bot</a></li>
    <li><a href="/logout">Logout</a></li>
  </ul>
</nav>

<section class="admin-shell">
  <div class="admin-topbar">
    <div>
      <p class="admin-kicker">Kontrolni centar</p>
      <h1>Admin Panel</h1>
      <p class="admin-subtitle">Upravljanje novostima, pravilima, blacklistom i logovima na jednom mjestu.</p>
    </div>
  </div>

  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <span class="admin-stat-label">Discord clanovi</span>
      <strong><%= discordMembers %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Ukupno slika</span>
      <strong><%= imagesCount %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Objave</span>
      <strong><%= newsCount %></strong>
    </div>
    <div class="admin-stat-card admin-stat-card-alert">
      <span class="admin-stat-label">Blacklist</span>
      <strong><%= blacklist ? blacklist.length : 0 %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Sync role</span>
      <strong><%= discordSync ? discordSync.rolesCount : 0 %></strong>
    </div>
  </div>

  <div class="admin-wrapper">

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('news')">
        <div>
          <span class="admin-header-label">Novosti</span>
          <small>Dodaj i brisi objave</small>
        </div>
        <span class="admin-header-count"><%= newsCount %></span>
      </div>

      <div id="news" class="admin-content open">
        <form method="POST" action="/admin/news" class="admin-form">
          <input type="text" name="title" placeholder="Naslov" required>
          <textarea name="content" placeholder="Sadrzaj..." required></textarea>
          <button type="submit" class="admin-action-btn">Objavi</button>
        </form>

        <div class="admin-divider"></div>

        <h3 class="admin-content-title">Postojece objave</h3>

        <% if (news && news.length > 0) { %>
          <div class="admin-list">
            <% news.forEach(post => { %>
              <div class="admin-news-item">
                <div class="news-left">
                  <strong><%= post.title %></strong>
                  <small><%= post.date %></small>
                </div>

                <form method="POST" action="/admin/news/delete/<%= post.id %>" data-confirm="Obrisati ovu objavu?" data-confirm-title="Brisanje objave" data-confirm-ok="Obriši">
                  <button type="submit" class="admin-danger-btn">Obrisi</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="admin-empty">Nema objava.</p>
        <% } %>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('rules')">
        <div>
          <span class="admin-header-label">Pravila</span>
          <small>Dodaj, uredi i obrisi pravila</small>
        </div>
        <span class="admin-header-count"><%= rules && rules.items ? rules.items.length : 0 %></span>
      </div>

      <div id="rules" class="admin-content">
        <div class="admin-rules-layout">
          <div class="admin-rules-sidebar">
            <form method="POST" action="/admin/rules" class="admin-form compact-form">
              <label class="admin-field-label">Naslov sekcije</label>
              <input type="text" name="title" value="<%= rules.title %>" placeholder="Naslov" required>

              <label class="admin-field-label">Podnaslov</label>
              <textarea name="subtitle" placeholder="Kratki opis..." required><%= rules.subtitle %></textarea>

              <label class="admin-field-label">Upozorenje</label>
              <textarea name="warning" placeholder="Zavrsna napomena..." required><%= rules.warning %></textarea>

              <button type="submit" class="admin-secondary-btn">Spremi zaglavlje</button>
            </form>

            <form method="POST" action="/admin/rules/add" class="admin-form compact-form">
              <label class="admin-field-label">Dodaj novo pravilo</label>
              <input type="text" name="ruleTitle" placeholder="Naslov pravila..." required>
              <textarea name="ruleContent" placeholder="Upisi objasnjenje pravila..." required></textarea>
              <button type="submit" class="admin-action-btn">Dodaj pravilo</button>
            </form>
          </div>

          <div class="admin-rules-list">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Aktivna pravila</h3>
              <span class="admin-pill"><%= rules && rules.items ? rules.items.length : 0 %></span>
            </div>

            <% if (rules && rules.items && rules.items.length > 0) { %>
              <div class="admin-list">
                <% rules.items.forEach((rule, index) => { %>
                  <div class="admin-rule-item">
                    <div class="admin-rule-index"><%= String(index + 1).padStart(2, '0') %></div>
                    <form method="POST" action="/admin/rules/update/<%= rule.id %>" class="admin-form admin-rule-form">
                      <input type="text" name="ruleTitle" value="<%= rule.title %>" placeholder="Naslov pravila" required>
                      <textarea name="ruleContent" required><%= rule.content %></textarea>
                      <div class="admin-inline-actions">
                        <button type="submit" class="admin-secondary-btn">Spremi izmjene</button>
                      </div>
                    </form>
                    <form method="POST" action="/admin/rules/delete/<%= rule.id %>" data-confirm="Obrisati ovo pravilo?" data-confirm-title="Brisanje pravila" data-confirm-ok="Obriši">
                      <button type="submit" class="admin-danger-btn">Obrisi</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="admin-empty">Jos nema pravila. Dodaj prvo pravilo iz lijevog bloka.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('blacklist')">
        <div>
          <span class="admin-header-label">Blacklist</span>
          <small>Dodaj i ukloni blokirane korisnike</small>
        </div>
        <span class="admin-header-count"><%= blacklist ? blacklist.length : 0 %></span>
      </div>

      <div id="blacklist" class="admin-content">
        <div class="admin-blacklist-layout">
          <div class="admin-blacklist-actions">
            <form method="POST" action="/admin/blacklist/add" class="admin-form compact-form">
              <label class="admin-field-label">Dodaj korisnika</label>
              <input type="text" name="userId" placeholder="Discord User ID" required>
              <button type="submit" class="admin-action-btn">Dodaj u blacklist</button>
            </form>

            <form method="POST" action="/admin/blacklist/remove" class="admin-form compact-form">
              <label class="admin-field-label">Makni korisnika</label>
              <input type="text" name="userId" placeholder="Discord User ID" required>
              <button type="submit" class="admin-secondary-btn">Ukloni iz blackliste</button>
            </form>
          </div>

          <div class="admin-blacklist-list">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Trenutno blokirani</h3>
              <span class="admin-pill"><%= blacklist ? blacklist.length : 0 %></span>
            </div>

            <% if (blacklist && blacklist.length > 0) { %>
              <div class="admin-list">
                <% blacklist.forEach(entry => { %>
                  <div class="admin-blacklist-item">
                    <div class="admin-blacklist-meta">
                      <strong><%= entry.username || 'Nepoznat korisnik' %></strong>
                      <code><%= entry.userId %></code>
                    </div>
                    <form method="POST" action="/admin/blacklist/remove">
                      <input type="hidden" name="userId" value="<%= entry.userId %>">
                      <button type="submit" class="admin-danger-btn">Makni</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="admin-empty">Blacklist je trenutno prazna.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('logs')">
        <div>
          <span class="admin-header-label">Admin logovi</span>
          <small>Zadnjih 20 akcija</small>
        </div>
        <span class="admin-header-icon">LOG</span>
      </div>

      <div id="logs" class="admin-content">
        <% if (!logs || logs.length === 0) { %>
          <p class="admin-empty">Nema logova.</p>
        <% } else { %>
          <div class="admin-list">
            <% logs.slice(0,20).forEach(log => { %>
              <div class="log-entry">
                <strong><%= log.admin %></strong> - <%= log.action %>
                <div class="log-date"><%= log.date %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</section>

<script src="/modal.js"></script>
</body>
</html>
