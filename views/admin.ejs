<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Admin Panel</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/style.css">

  <script>
    function togglePanel(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.toggle("open");
    }
  </script>
</head>
<body>

<nav class="navbar">
  <div class="logo">
    <img src="/images/logo.png" alt="SR Logo">
    <span>Slavonska Ravnica</span>
  </div>
  <ul>
    <li><a href="/">Početna</a></li>
    <li><a href="/galerija">Galerija</a></li>
    <li><a href="/pravila">Pravila</a></li>
    <li><a href="/statistika">Statistika</a></li>
    <li><a href="/moja-farma">Moja Farma</a></li>
    <li><a href="/profile">Profil</a></li>
    <li><a href="/logout">Logout</a></li>
  </ul>
</nav>

<section class="admin-shell">
  <div class="admin-topbar">
    <div>
      <p class="admin-kicker">Kontrolni centar</p>
      <h1>Admin Panel</h1>
      <p class="admin-subtitle">Upravljanje novostima, pravilima, blacklistom i logovima na jednom mjestu.</p>
    </div>
  </div>

  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <span class="admin-stat-label">Discord clanovi</span>
      <strong><%= discordMembers %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Ukupno slika</span>
      <strong><%= imagesCount %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Objave</span>
      <strong><%= newsCount %></strong>
    </div>
    <div class="admin-stat-card admin-stat-card-alert">
      <span class="admin-stat-label">Blacklist</span>
      <strong><%= blacklist ? blacklist.length : 0 %></strong>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-label">Sync role</span>
      <strong><%= discordSync ? discordSync.rolesCount : 0 %></strong>
    </div>
  </div>

  <div class="admin-wrapper">

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('news')">
        <div>
          <span class="admin-header-label">Novosti</span>
          <small>Dodaj i brisi objave</small>
        </div>
        <span class="admin-header-count"><%= newsCount %></span>
      </div>

      <div id="news" class="admin-content open">
        <form method="POST" action="/admin/news" class="admin-form">
          <input type="text" name="title" placeholder="Naslov" required>
          <textarea name="content" placeholder="Sadrzaj..." required></textarea>
          <button type="submit" class="admin-action-btn">Objavi</button>
        </form>

        <div class="admin-divider"></div>

        <h3 class="admin-content-title">Postojece objave</h3>

        <% if (news && news.length > 0) { %>
          <div class="admin-list">
            <% news.forEach(post => { %>
              <div class="admin-news-item">
                <div class="news-left">
                  <strong><%= post.title %></strong>
                  <small><%= post.date %></small>
                </div>

                <form method="POST" action="/admin/news/delete/<%= post.id %>" onsubmit="return confirm('Obrisati ovu objavu?')">
                  <button type="submit" class="admin-danger-btn">Obrisi</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="admin-empty">Nema objava.</p>
        <% } %>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('rules')">
        <div>
          <span class="admin-header-label">Pravila</span>
          <small>Dodaj, uredi i obrisi pravila</small>
        </div>
        <span class="admin-header-count"><%= rules && rules.items ? rules.items.length : 0 %></span>
      </div>

      <div id="rules" class="admin-content">
        <div class="admin-rules-layout">
          <div class="admin-rules-sidebar">
            <form method="POST" action="/admin/rules" class="admin-form compact-form">
              <label class="admin-field-label">Naslov sekcije</label>
              <input type="text" name="title" value="<%= rules.title %>" placeholder="Naslov" required>

              <label class="admin-field-label">Podnaslov</label>
              <textarea name="subtitle" placeholder="Kratki opis..." required><%= rules.subtitle %></textarea>

              <label class="admin-field-label">Upozorenje</label>
              <textarea name="warning" placeholder="Zavrsna napomena..." required><%= rules.warning %></textarea>

              <button type="submit" class="admin-secondary-btn">Spremi zaglavlje</button>
            </form>

            <form method="POST" action="/admin/rules/add" class="admin-form compact-form">
              <label class="admin-field-label">Dodaj novo pravilo</label>
              <input type="text" name="ruleTitle" placeholder="Naslov pravila..." required>
              <textarea name="ruleContent" placeholder="Upisi objasnjenje pravila..." required></textarea>
              <button type="submit" class="admin-action-btn">Dodaj pravilo</button>
            </form>
          </div>

          <div class="admin-rules-list">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Aktivna pravila</h3>
              <span class="admin-pill"><%= rules && rules.items ? rules.items.length : 0 %></span>
            </div>

            <% if (rules && rules.items && rules.items.length > 0) { %>
              <div class="admin-list">
                <% rules.items.forEach((rule, index) => { %>
                  <div class="admin-rule-item">
                    <div class="admin-rule-index"><%= String(index + 1).padStart(2, '0') %></div>
                    <form method="POST" action="/admin/rules/update/<%= rule.id %>" class="admin-form admin-rule-form">
                      <input type="text" name="ruleTitle" value="<%= rule.title %>" placeholder="Naslov pravila" required>
                      <textarea name="ruleContent" required><%= rule.content %></textarea>
                      <div class="admin-inline-actions">
                        <button type="submit" class="admin-secondary-btn">Spremi izmjene</button>
                      </div>
                    </form>
                    <form method="POST" action="/admin/rules/delete/<%= rule.id %>" onsubmit="return confirm('Obrisati ovo pravilo?')">
                      <button type="submit" class="admin-danger-btn">Obrisi</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="admin-empty">Jos nema pravila. Dodaj prvo pravilo iz lijevog bloka.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('blacklist')">
        <div>
          <span class="admin-header-label">Blacklist</span>
          <small>Dodaj i ukloni blokirane korisnike</small>
        </div>
        <span class="admin-header-count"><%= blacklist ? blacklist.length : 0 %></span>
      </div>

      <div id="blacklist" class="admin-content">
        <div class="admin-blacklist-layout">
          <div class="admin-blacklist-actions">
            <form method="POST" action="/admin/blacklist/add" class="admin-form compact-form">
              <label class="admin-field-label">Dodaj korisnika</label>
              <input type="text" name="userId" placeholder="Discord User ID" required>
              <button type="submit" class="admin-action-btn">Dodaj u blacklist</button>
            </form>

            <form method="POST" action="/admin/blacklist/remove" class="admin-form compact-form">
              <label class="admin-field-label">Makni korisnika</label>
              <input type="text" name="userId" placeholder="Discord User ID" required>
              <button type="submit" class="admin-secondary-btn">Ukloni iz blackliste</button>
            </form>
          </div>

          <div class="admin-blacklist-list">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Trenutno blokirani</h3>
              <span class="admin-pill"><%= blacklist ? blacklist.length : 0 %></span>
            </div>

            <% if (blacklist && blacklist.length > 0) { %>
              <div class="admin-list">
                <% blacklist.forEach(entry => { %>
                  <div class="admin-blacklist-item">
                    <div class="admin-blacklist-meta">
                      <strong><%= entry.username || 'Nepoznat korisnik' %></strong>
                      <code><%= entry.userId %></code>
                    </div>
                    <form method="POST" action="/admin/blacklist/remove">
                      <input type="hidden" name="userId" value="<%= entry.userId %>">
                      <button type="submit" class="admin-danger-btn">Makni</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="admin-empty">Blacklist je trenutno prazna.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('bot-settings')">
        <div>
          <span class="admin-header-label">Discord Bot</span>
          <small>Centralne postavke bota preko web panela</small>
        </div>
        <span class="admin-header-count"><%= syncedRoles ? syncedRoles.length : 0 %></span>
      </div>

      <div id="bot-settings" class="admin-content">
        <% const bot = botConfig || {}; const ticket = bot.ticketSystem || {}; %>
        <div class="admin-rules-layout">
          <div class="admin-rules-sidebar">
            <form method="POST" action="/admin/discord-sync" class="admin-form compact-form">
              <label class="admin-field-label">Discord sinkronizacija</label>
              <p class="admin-empty">Role: <%= discordSync ? discordSync.rolesCount : 0 %> | Članovi: <%= discordSync ? discordSync.membersCount : 0 %> | Veze: <%= discordSync ? discordSync.memberRolesCount : 0 %></p>
              <button type="submit" class="admin-action-btn">Pokreni sync</button>
            </form>

            <form method="POST" action="/admin/bot/greetings" class="admin-form compact-form">
              <label class="admin-field-label">Welcome postavke</label>
              <input type="text" name="welcomeChannelId" value="<%= bot.welcome ? bot.welcome.channelId : '' %>" list="guild-channels" placeholder="Welcome kanal ID">
              <textarea name="welcomeMessage" placeholder="Dobrodošlica..."><%= bot.welcome ? bot.welcome.message : '' %></textarea>
              <button type="submit" class="admin-secondary-btn">Spremi welcome</button>
            </form>

            <form method="POST" action="/admin/bot/logging" class="admin-form compact-form">
              <label class="admin-field-label">Log kanal</label>
              <input type="text" name="logChannelId" value="<%= bot.logging ? bot.logging.channelId : '' %>" list="guild-channels" placeholder="Log kanal ID">
              <button type="submit" class="admin-secondary-btn">Spremi logging</button>
            </form>

            <form method="POST" action="/admin/bot/gallery" class="admin-form compact-form">
              <label class="admin-field-label">Galerija kanal</label>
              <input type="text" name="galleryChannelId" value="<%= bot.gallery ? bot.gallery.channelId : '' %>" list="guild-channels" placeholder="Discord kanal za slike">
              <button type="submit" class="admin-secondary-btn">Spremi galeriju</button>
            </form>
          </div>

          <div class="admin-rules-list">
            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Ticket sistem</h3>
              <span class="admin-pill"><%= syncedRoles ? syncedRoles.length : 0 %> rola</span>
            </div>

            <form method="POST" action="/admin/bot/tickets" class="admin-form admin-rule-form">
              <input type="text" name="ticketCategoryId" value="<%= ticket.categoryId || '' %>" list="guild-channels" placeholder="Ticket kategorija ID">
              <input type="text" name="ticketLogChannelId" value="<%= ticket.logChannelId || '' %>" list="guild-channels" placeholder="Ticket log kanal ID">
              <input type="text" name="ticketSupportRoleId" value="<%= ticket.supportRoleId || '' %>" list="guild-roles" placeholder="Support role ID">
              <input type="number" name="autoCloseHours" min="1" value="<%= ticket.autoCloseHours || 48 %>" placeholder="Auto close sati">
              <input type="number" name="reminderHours" min="1" value="<%= ticket.reminderHours || 3 %>" placeholder="Reminder sati">
              <textarea name="igranjeQuestions" rows="6" placeholder="Igranje pitanja"><%= ticket.types && ticket.types.igranje ? ticket.types.igranje.questions.join('\n') : '' %></textarea>
              <textarea name="zalbaQuestions" rows="4" placeholder="Žalba pitanja"><%= ticket.types && ticket.types.zalba ? ticket.types.zalba.questions.join('\n') : '' %></textarea>
              <textarea name="modoviQuestions" rows="4" placeholder="Modovi pitanja"><%= ticket.types && ticket.types.modovi ? ticket.types.modovi.questions.join('\n') : '' %></textarea>
              <textarea name="reminderMessage" rows="4" placeholder="Reminder poruka"><%= ticket.messages ? ticket.messages.reminder : '' %></textarea>
              <textarea name="autoCloseMessage" rows="4" placeholder="Auto close poruka"><%= ticket.messages ? ticket.messages.autoClose : '' %></textarea>
              <div class="admin-inline-actions">
                <button type="submit" class="admin-action-btn">Spremi ticket postavke</button>
              </div>
            </form>

            <div class="admin-divider"></div>

            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Pošalji embed</h3>
              <span class="admin-pill"><%= bot.embeds ? bot.embeds.length : 0 %></span>
            </div>

            <form method="POST" action="/admin/bot/embeds" class="admin-form admin-rule-form">
              <input type="text" name="embedChannelId" list="guild-channels" placeholder="Kanal ID" required>
              <input type="text" name="title" placeholder="Naslov embed-a">
              <textarea name="description" rows="4" placeholder="Opis embed-a"></textarea>
              <input type="text" name="color" placeholder="#2f855a">
              <input type="text" name="authorName" placeholder="Autor">
              <input type="text" name="authorIcon" placeholder="Author icon URL">
              <input type="text" name="footerText" placeholder="Footer tekst">
              <input type="text" name="footerIcon" placeholder="Footer icon URL">
              <input type="text" name="thumbnailUrl" placeholder="Thumbnail URL">
              <input type="text" name="imageUrl" placeholder="Image URL">
              <input type="text" name="launcherButtonLabel" placeholder="Tekst dugmeta">
              <input type="text" name="launcherButtonUrl" placeholder="Link dugmeta">
              <textarea name="normalMessage" rows="2" placeholder="Običan tekst uz embed"></textarea>
              <label class="admin-field-label"><input type="checkbox" name="timestamp" checked> Dodaj timestamp</label>
              <div class="admin-inline-actions">
                <button type="submit" class="admin-action-btn">Pošalji embed</button>
              </div>
            </form>

            <div class="admin-divider"></div>

            <div class="admin-content-title-row">
              <h3 class="admin-content-title">Sinkronizirane role</h3>
              <span class="admin-pill"><%= syncedRoles ? syncedRoles.length : 0 %></span>
            </div>

            <% if (syncedRoles && syncedRoles.length > 0) { %>
              <div class="all-roles">
                <% syncedRoles.forEach(role => { %>
                  <span class="role-pill" style="background:<%= role.color || '#444' %>"><%= role.name %></span>
                <% }) %>
              </div>
            <% } else { %>
              <p class="admin-empty">Role još nisu sinkronizirane.</p>
            <% } %>
          </div>
        </div>

        <datalist id="guild-channels">
          <% (guildChannels || []).forEach(channel => { %>
            <option value="<%= channel.id %>"><%= channel.name %></option>
          <% }) %>
        </datalist>

        <datalist id="guild-roles">
          <% (syncedRoles || []).forEach(role => { %>
            <option value="<%= role.id %>"><%= role.name %></option>
          <% }) %>
        </datalist>
      </div>
    </div>

    <div class="admin-section">
      <div class="admin-header" onclick="togglePanel('logs')">
        <div>
          <span class="admin-header-label">Admin logovi</span>
          <small>Zadnjih 20 akcija</small>
        </div>
        <span class="admin-header-icon">LOG</span>
      </div>

      <div id="logs" class="admin-content">
        <% if (!logs || logs.length === 0) { %>
          <p class="admin-empty">Nema logova.</p>
        <% } else { %>
          <div class="admin-list">
            <% logs.slice(0,20).forEach(log => { %>
              <div class="log-entry">
                <strong><%= log.admin %></strong> - <%= log.action %>
                <div class="log-date"><%= log.date %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</section>

</body>
</html>
