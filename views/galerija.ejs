<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Galerija</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="gallery-page">

<div id="gallery-toast" class="gallery-toast" hidden></div>

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>
    <ul>
        <li><a href="/">Početna</a></li>
        <li><a href="/galerija">Galerija</a></li>
        <li><a href="/pravila">Pravila</a></li>
        <li><a href="/statistika">Statistika</a></li>
        <li><a href="/moja-farma">Moja Farma</a></li>
        <% if(user){ %>
            <li><a href="/profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout">Logout</a></li>
        <% } else { %>
            <li><a href="/auth/discord">Login</a></li>
        <% } %>
    </ul>
</nav>

<section class="gallery-shell">
    <div class="gallery-hero-panel">
        <p class="gallery-kicker">Community media</p>
        <h1 class="gallery-title">Galerija Zajednice</h1>
        <p class="gallery-subtitle">Podijeli trenutke sa servera, reagiraj na objave i pregledaj komentare u proširenom prikazu.</p>
    </div>

    <% if (user && canUpload) { %>
    <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form upload-form-pro" id="gallery-upload-form">
        <div class="upload-form-fields">
            <label class="upload-field">
                <span>Odaberi sliku</span>
                <input type="file" name="image" required>
            </label>
            <label class="upload-field upload-field-wide">
                <span>Opis slike</span>
                <textarea name="description" placeholder="Dodaj kratak opis, priču ili detalj sa slike..."></textarea>
            </label>
        </div>
        <button class="btn-primary" type="submit">Objavi sliku</button>
    </form>
    <% } %>

    <div class="gallery-grid gallery-grid-rich">
    <% if (gallery && gallery.length > 0) { %>
        <% gallery.forEach(function(img, index){ %>
        <% const avatarSrc = img.uploaderAvatar ? `https://cdn.discordapp.com/avatars/${img.uploaderId}/${img.uploaderAvatar}.png` : '/images/logo.png'; %>
        <% const previewComments = (img.comments || []).slice(0, 3); %>
        <article class="gallery-card gallery-card-rich" data-filename="<%= img.filename %>">
            <div class="gallery-card-media">
                <img
                    src="/uploads/<%= img.filename %>"
                    onclick="openGalleryModal('modal-<%= index %>')"
                    alt="slika"
                >

                <% if (isAdmin) { %>
                <form action="/delete" method="POST" data-confirm="Obrisati sliku?" data-confirm-title="Brisanje slike" data-confirm-ok="Obriši">
                    <input type="hidden" name="image" value="<%= img.filename %>">
                    <button type="submit" class="gallery-delete-btn">Obriši</button>
                </form>
                <% } %>
            </div>

            <div class="gallery-card-body">
                <div class="uploader uploader-rich">
                    <img src="<%= avatarSrc %>" alt="<%= img.uploaderName %>">
                    <div>
                        <span><%= img.uploaderName %></span>
                        <small><%= img.comments ? img.comments.length : 0 %> komentara</small>
                    </div>
                </div>

                <% if (img.description) { %>
                    <p class="gallery-description"><%= img.description %></p>
                <% } %>

                <div class="gallery-reactions">
                    <form action="/react/<%= img.filename %>" method="POST">
                        <input type="hidden" name="reaction" value="like">
                        <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                        <button type="submit" class="reaction-btn <%= img.viewerReactions?.like ? 'reaction-btn-active' : '' %>">
                            <span>👍</span>
                            <strong><%= img.reactions?.like || 0 %></strong>
                        </button>
                    </form>
                    <form action="/react/<%= img.filename %>" method="POST">
                        <input type="hidden" name="reaction" value="heart">
                        <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                        <button type="submit" class="reaction-btn <%= img.viewerReactions?.heart ? 'reaction-btn-active' : '' %>">
                            <span>❤</span>
                            <strong><%= img.reactions?.heart || 0 %></strong>
                        </button>
                    </form>
                    <form action="/react/<%= img.filename %>" method="POST">
                        <input type="hidden" name="reaction" value="sr">
                        <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                        <button type="submit" class="reaction-btn reaction-btn-logo <%= img.viewerReactions?.sr ? 'reaction-btn-active' : '' %>">
                            <img src="/images/logo.png" alt="SR">
                            <strong><%= img.reactions?.sr || 0 %></strong>
                        </button>
                    </form>
                </div>

                <div class="comments comments-preview">
                    <div class="comments-header">
                        <strong>Komentari</strong>
                        <% if ((img.comments || []).length > 3) { %>
                            <button type="button" class="comments-more-link" onclick="openGalleryModal('modal-<%= index %>')">
                                Prikaži sve
                            </button>
                        <% } %>
                    </div>

                    <% if (previewComments.length > 0) { %>
                        <% previewComments.forEach(function(c){ %>
                            <div class="comment comment-card">
                                <strong><%= c.user %></strong>
                                <span><%= c.text %></span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="comment-empty">Još nema komentara.</p>
                    <% } %>

                    <% if (user) { %>
                    <form action="/comment/<%= img.filename %>" method="POST" class="comment-form comment-form-inline">
                        <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                        <input type="text" name="comment" placeholder="Dodaj komentar..." required>
                        <button type="submit">Objavi</button>
                    </form>
                    <% } %>
                </div>
            </div>

            <div id="modal-<%= index %>" class="gallery-modal-template" hidden>
                <div class="gallery-lightbox-layout">
                    <div class="gallery-lightbox-main">
                        <img src="/uploads/<%= img.filename %>" alt="slika">
                    </div>
                    <aside class="gallery-lightbox-sidebar">
                        <div class="gallery-lightbox-sidebar-top">
                            <div class="uploader uploader-rich">
                                <img src="<%= avatarSrc %>" alt="<%= img.uploaderName %>">
                                <div>
                                    <span><%= img.uploaderName %></span>
                                    <small><%= img.comments ? img.comments.length : 0 %> komentara</small>
                                </div>
                            </div>
                            <% if (img.description) { %>
                                <p class="gallery-description gallery-description-modal"><%= img.description %></p>
                            <% } %>
                            <div class="gallery-reactions gallery-reactions-modal">
                                <form action="/react/<%= img.filename %>" method="POST">
                                    <input type="hidden" name="reaction" value="like">
                                    <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                                    <button type="submit" class="reaction-btn <%= img.viewerReactions?.like ? 'reaction-btn-active' : '' %>">
                                        <span>👍</span>
                                        <strong><%= img.reactions?.like || 0 %></strong>
                                    </button>
                                </form>
                                <form action="/react/<%= img.filename %>" method="POST">
                                    <input type="hidden" name="reaction" value="heart">
                                    <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                                    <button type="submit" class="reaction-btn <%= img.viewerReactions?.heart ? 'reaction-btn-active' : '' %>">
                                        <span>❤</span>
                                        <strong><%= img.reactions?.heart || 0 %></strong>
                                    </button>
                                </form>
                                <form action="/react/<%= img.filename %>" method="POST">
                                    <input type="hidden" name="reaction" value="sr">
                                    <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                                    <button type="submit" class="reaction-btn reaction-btn-logo <%= img.viewerReactions?.sr ? 'reaction-btn-active' : '' %>">
                                        <img src="/images/logo.png" alt="SR">
                                        <strong><%= img.reactions?.sr || 0 %></strong>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="gallery-lightbox-comments">
                            <h3>Svi komentari</h3>
                            <% if (img.comments && img.comments.length > 0) { %>
                                <% img.comments.forEach(function(c){ %>
                                    <div class="comment comment-modal">
                                        <div class="comment-modal-head">
                                            <strong><%= c.user %></strong>
                                            <small><%= c.date %></small>
                                        </div>
                                        <p><%= c.text %></p>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="comment-empty">Još nema komentara za ovu sliku.</p>
                            <% } %>
                        </div>

                        <% if (user) { %>
                        <form action="/comment/<%= img.filename %>" method="POST" class="comment-form comment-form-modal">
                            <input type="hidden" name="returnTo" value="/galerija?open=<%= encodeURIComponent(img.filename) %>">
                            <label>Dodaj komentar</label>
                            <textarea name="comment" placeholder="Napiši komentar..." required></textarea>
                            <button type="submit">Objavi komentar</button>
                        </form>
                        <% } %>
                    </aside>
                </div>
            </div>
        </article>
        <% }) %>
    <% } else { %>
        <p class="gallery-empty-state">Nema uploadanih slika.</p>
    <% } %>
    </div>
</section>

<div id="gallery-lightbox" class="gallery-lightbox-overlay" onclick="closeGalleryModal(event)">
    <button type="button" class="gallery-lightbox-close" onclick="closeGalleryModal(event)">Zatvori</button>
    <div id="gallery-lightbox-content"></div>
</div>

<script>
const uploadBlocked = <%- JSON.stringify(Boolean(uploadBlocked)) %>;
const uploadNotice = <%- JSON.stringify(uploadNotice || '') %>;

function showGalleryToast(message) {
    const toast = document.getElementById('gallery-toast');
    if (!toast) return;
    toast.textContent = message;
    toast.hidden = false;
    toast.classList.remove('gallery-toast-visible');

    requestAnimationFrame(function () {
        toast.classList.add('gallery-toast-visible');
    });

    clearTimeout(showGalleryToast.dismissTimer);
    showGalleryToast.dismissTimer = setTimeout(function () {
        toast.classList.remove('gallery-toast-visible');
        setTimeout(function () {
            toast.hidden = true;
        }, 280);
    }, 3200);
}

function openGalleryModal(templateId) {
    const template = document.getElementById(templateId);
    const overlay = document.getElementById('gallery-lightbox');
    const content = document.getElementById('gallery-lightbox-content');
    if (!template || !overlay || !content) return;
    content.innerHTML = template.innerHTML;
    overlay.style.display = 'flex';
    document.body.classList.add('modal-open');
}

const openImage = <%- JSON.stringify(openImage || '') %>;
if (openImage) {
    const cards = Array.from(document.querySelectorAll('[data-filename]'));
    const targetCard = cards.find(function (card) {
        return card.getAttribute('data-filename') === openImage;
    });
    if (targetCard) {
        const modalTemplate = targetCard.querySelector('.gallery-modal-template');
        if (modalTemplate && modalTemplate.id) {
            openGalleryModal(modalTemplate.id);
        }
    }
}

function closeGalleryModal(event) {
    if (event) {
        const target = event.target;
        const clickedBackdrop = target.id === 'gallery-lightbox';
        const clickedClose = target.classList && target.classList.contains('gallery-lightbox-close');
        if (!clickedBackdrop && !clickedClose) return;
    }

    const overlay = document.getElementById('gallery-lightbox');
    const content = document.getElementById('gallery-lightbox-content');
    if (!overlay || !content) return;
    overlay.style.display = 'none';
    content.innerHTML = '';
    document.body.classList.remove('modal-open');
}

document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
        closeGalleryModal();
    }
});

const uploadForm = document.getElementById('gallery-upload-form');
if (uploadForm && uploadBlocked) {
    uploadForm.addEventListener('submit', function (event) {
        event.preventDefault();
        showGalleryToast('Trenutno si na BLACKLISTI i nemaš dozvolu za upload.');
    });
}

if (uploadNotice === 'blocked') {
    showGalleryToast('Trenutno si na BLACKLISTI i nemaš dozvolu za upload.');
}
</script>

<script src="/modal.js"></script>
</body>
</html>
