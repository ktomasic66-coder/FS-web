<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Statistika Servera</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>
    <ul>
        <li><a href="/" data-i18n="home">Početna</a></li>
        <li><a href="/galerija" data-i18n="gallery">Galerija</a></li>
        <li><a href="/pravila" data-i18n="rules">Pravila</a></li>
        <li><a href="/statistika" data-i18n="statistics">Statistika</a></li>
        <li><a href="/moja-farma" data-i18n="myFarm">Moja Farma</a></li>
        <% if(user){ %>
            <li><a href="/profile" data-i18n="profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout" data-i18n="logout">Logout</a></li>
        <% } else { %>
            <li><a href="/auth/discord" data-i18n="login">Login</a></li>
        <% } %>
    </ul>
</nav>

<div class="admin-page">
    <div class="admin-topbar">
        <p class="admin-kicker" data-i18n="serverPolicy">Server info</p>
        <h1 data-i18n="serverStats">Statistika Servera</h1>
        <p class="admin-subtitle" data-i18n="serverStatsDesc">Pregled stanja servera, igrača i ukupne statistike farmi.</p>
    </div>

    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="serverStatus">Status Servera</span>
            <strong class="status <%= stats.serverStatus.toLowerCase() %>"><%= stats.serverStatus %></strong>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="playersOnline">Igrači Online</span>
            <strong><%= stats.playersOnline %> / <%= stats.maxPlayers %></strong>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="discordMembers">Discord Članovi</span>
            <strong><%= stats.discordMembers %></strong>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="totalFarms">Ukupno Farmi</span>
            <strong><%= stats.totalFarms %></strong>
        </div>
    </div>

    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="totalFields">Ukupno Polja</span>
            <strong><%= stats.totalFields %></strong>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="totalVehicles">Ukupno Vozila</span>
            <strong><%= stats.totalVehicles %></strong>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-label" data-i18n="players">Igrači</span>
            <strong><%= stats.totalPlayers %></strong>
        </div>
    </div>
</div>

<script src="/modal.js"></script>
<script src="/site.js"></script></body>
</html>
