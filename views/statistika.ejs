<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Statistika Servera</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">
        <img src="/images/logo.png" alt="SR Logo">
        <span>Slavonska Ravnica</span>
    </div>
    <ul>
        <li><a href="/">Početna</a></li>
        <li><a href="/galerija" data-i18n="gallery">Galerija</a></li>
        <li><a href="/pravila" data-i18n="rules">Pravila</a></li>
        <li><a href="/statistika" data-i18n="statistics">Statistika</a></li>
        <li><a href="/moja-farma" data-i18n="myFarm">Moja Farma</a></li>
        <% if(user){ %>
            <li><a href="/profile" data-i18n="profile">Profil</a></li>
            <% if (canAdminNav) { %>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/bot-settings">Bot</a></li>
            <% } %>
            <li><a href="/logout" data-i18n="logout">Logout</a></li>
        <% } else { %>
            <li><a href="/auth/discord" data-i18n="login">Login</a></li>
        <% } %>
    </ul>
</nav>

<div class="hero">
    <h1>Statistika Servera</h1>

    <div class="stats-container">

        <div class="stat-card">
            <h2>Status Servera</h2>
            <p class="status <%= stats.serverStatus.toLowerCase() %>">
                <%= stats.serverStatus %>
            </p>
        </div>

        <div class="stat-card">
            <h2>Igrači Online</h2>
            <p><%= stats.playersOnline %> / <%= stats.maxPlayers %></p>
        </div>

        <div class="stat-card">
            <h2>Discord Članovi</h2>
            <p><%= stats.discordMembers %></p>
        </div>

    </div>
</div>

<script src="/modal.js"></script>
<script src="/site.js"></script></body>
</html>
